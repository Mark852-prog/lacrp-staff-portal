# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file or paste these values in chat/Discord.

PORT=3000

# A long random string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_string

# From the Discord Developer Portal -> Your App -> OAuth2
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here

# From the Discord Developer Portal -> Your App -> Bot
# The bot must be invited to your server (no privileged intents required
# for this. A single guild-member lookup works over the REST API).
DISCORD_BOT_TOKEN=your_bot_token_here

# Your Discord server's ID (enable Developer Mode in Discord settings,
# then right-click the server icon -> Copy Server ID)
DISCORD_GUILD_ID=your_server_id_here

# Must exactly match a Redirect URI registered in the Discord Developer Portal
DISCORD_REDIRECT_URI=http://localhost:3000/callback

NODE_ENV=development
